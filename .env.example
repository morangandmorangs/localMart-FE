# Copy to .env for local overrides. Every value is optional.

# localMart-BEE base URL, ending in /api. Leave unset in development: "/api" is
# proxied to the local backend on http://localhost:8080 (see vite.config.ts).
# Production builds take it from .env.production.
VITE_API_URL=

# Firebase Analytics (the site has no sign-in). Leave VITE_FIREBASE_MEASUREMENT_ID
# unset and Firebase is not started at all.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_MEASUREMENT_ID=
